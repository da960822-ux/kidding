{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batmeori.invalid/schemas/stt-v1.schema.json",
  "title": "Batmeori stt-v1 output",
  "type": "object",
  "additionalProperties": false,
  "required": ["transcript", "language_code", "confidence", "schema_version", "contract_version"],
  "properties": {
    "transcript": {"type": "string", "minLength": 1},
    "language_code": {"const": "ko"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "schema_version": {"const": "1"},
    "contract_version": {"const": "stt-v1"}
  }
}
