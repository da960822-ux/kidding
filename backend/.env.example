# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Farm-scoped owner authentication. Access codes and PIN hashes stay in DB.
# Keep this stable across deploys. Rotating it invalidates owner sessions,
# TodayWorkTeam QR/member cookies, and all WorkerLinks.
OWNER_SESSION_SECRET=replace-with-a-long-random-secret
OWNER_SESSION_TTL_SECONDS=7200

# Exact browser origins, comma separated. Never use * with credentials.
# In deployed Vercel+Render, all three public values use the same Vercel origin.
FRONTEND_ORIGINS=https://your-app.vercel.app
# Browser route host. Required outside DEMO_FALLBACK=1.
PUBLIC_WEB_BASE_URL=https://your-app.vercel.app
# Same-origin /api host used for package TTS URLs; bytes stay in server-side cache.
PUBLIC_API_BASE_URL=https://your-app.vercel.app
# Optional outside Render. Render supplies RENDER_GIT_COMMIT automatically.
APP_REVISION=local

# FastAPI only starts the private JSONL/stdio transport. Node owns providers.
NODE_BINARY=node
AI_BRIDGE_TIMEOUT_SECONDS=60
OPENAI_API_KEY=replace-with-server-only-key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TRANSCRIBE_VERIFICATION_MODEL=gpt-4o-transcribe
OPENAI_TRANSCRIBE_LOGPROB_THRESHOLD=-0.5
OPENAI_TRANSCRIPT_REVIEW_MODEL=gpt-4o-mini
OPENAI_TTS_VOICE=alloy
