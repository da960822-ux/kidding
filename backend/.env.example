# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Farm-scoped demo owner authentication. PIN hashes and seed rows stay in DB.
OWNER_SESSION_SECRET=replace-with-a-long-random-secret
OWNER_SESSION_TTL_SECONDS=7200

# Exact FE origins, comma separated. Never use * with credentials.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Browser route host. Required outside DEMO_FALLBACK=1; use your local Vite URL locally.
PUBLIC_WEB_BASE_URL=http://localhost:5173
# API host used for package TTS URLs; bytes stay in the server-side tts_assets cache.
PUBLIC_API_BASE_URL=http://localhost:8000

# FastAPI only starts the private JSONL/stdio transport. Node owns providers.
NODE_BINARY=node
AI_BRIDGE_TIMEOUT_SECONDS=60
OPENAI_API_KEY=replace-with-server-only-key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TTS_VOICE=alloy
