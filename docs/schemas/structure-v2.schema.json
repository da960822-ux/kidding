{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batmeori.example.invalid/schemas/structure-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["interpretation", "summary_ko", "location", "task_family", "quantity", "deadline", "safety", "notes", "steps", "ambiguities", "schema_version", "contract_version", "ontology_version"],
  "properties": {
    "interpretation": {"enum": ["READY", "AMBIGUOUS", "UNSUPPORTED"]},
    "summary_ko": {"type": "string", "minLength": 1},
    "location": {"$ref": "#/$defs/location"},
    "task_family": {"enum": ["ONION", "STRAWBERRY"]},
    "quantity": {"anyOf": [{"$ref": "#/$defs/quantity"}, {"const": "UNSPECIFIED"}, {"type": "null"}]},
    "deadline": {"type": ["string", "null"]},
    "safety": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "notes": {"type": ["string", "null"]},
    "steps": {"type": "array", "minItems": 0, "items": {"$ref": "#/$defs/step"}},
    "ambiguities": {"type": "array", "items": {"$ref": "#/$defs/ambiguity"}},
    "schema_version": {"const": "2"},
    "contract_version": {"const": "structure-v2"},
    "ontology_version": {"const": "ontology-v2"}
  },
  "allOf": [
    {
      "if": {"properties": {"interpretation": {"const": "AMBIGUOUS"}}, "required": ["interpretation"]},
      "then": {"properties": {"ambiguities": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"interpretation": {"enum": ["READY", "UNSUPPORTED"]}}, "required": ["interpretation"]},
      "then": {"properties": {"steps": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"steps": {"maxItems": 0}}, "required": ["steps"]},
      "then": {
        "properties": {
          "interpretation": {"const": "AMBIGUOUS"},
          "ambiguities": {
            "contains": {
              "type": "object",
              "required": ["blocking", "kind"],
              "properties": {"blocking": {"const": true}, "kind": {"const": "TASK"}}
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {"properties": {"task_family": {"const": "ONION"}}},
      "then": {"properties": {"steps": {"items": {"properties": {"task_code": {"anyOf": [{"enum": ["ONION_HARVEST", "ONION_TRIMMING", "ONION_SORTING", "ONION_TRANSPORT"]}, {"type": "null"}]}}}}}}
    },
    {
      "if": {"properties": {"task_family": {"const": "STRAWBERRY"}}},
      "then": {"properties": {"steps": {"items": {"properties": {"task_code": {"anyOf": [{"enum": ["STRAWBERRY_HARVEST", "STRAWBERRY_SORTING", "STRAWBERRY_INSPECTION", "STRAWBERRY_PACKING"]}, {"type": "null"}]}}}}}}
    }
  ],
  "$defs": {
    "location": {"type": "object", "additionalProperties": false, "required": ["raw_text", "kind", "canonical_name"], "properties": {"raw_text": {"type": ["string", "null"]}, "kind": {"enum": ["DEICTIC", "NAMED", "UNSPECIFIED"]}, "canonical_name": {"type": ["string", "null"]}}},
    "quantity": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"type": "integer", "minimum": 1}, "unit": {"type": "string", "minLength": 1}}},
    "step": {"type": "object", "additionalProperties": false, "required": ["sequence", "task_code", "title_ko", "description_ko", "unsupported_reason"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "task_code": {"anyOf": [{"type": "string", "enum": ["ONION_HARVEST", "ONION_TRIMMING", "ONION_SORTING", "ONION_TRANSPORT", "STRAWBERRY_HARVEST", "STRAWBERRY_SORTING", "STRAWBERRY_INSPECTION", "STRAWBERRY_PACKING"]}, {"type": "null"}]}, "title_ko": {"type": "string", "minLength": 1}, "description_ko": {"type": "string", "minLength": 1}, "unsupported_reason": {"type": ["string", "null"]}}},
    "ambiguity": {"type": "object", "additionalProperties": false, "required": ["field", "message", "blocking", "kind"], "properties": {"field": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "blocking": {"type": "boolean"}, "kind": {"enum": ["SAFETY", "TASK", "LOCATION", "QUANTITY", "TIME", "OTHER"]}}}
  }
}
