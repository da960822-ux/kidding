# Public Vercel build variables. Never put server secrets in VITE_* values.
# Leave this empty in Vercel production: browser calls same-origin /api via vercel.ts.
VITE_API_BASE_URL=
VITE_USE_MOCK_API=false

# Local Vite /api proxy. Keep browser requests same-origin.
API_UPSTREAM_ORIGIN=http://127.0.0.1:8000
# In Vercel project settings, replace it with the HTTPS Render API origin.
# vercel.ts requires an HTTPS origin without a trailing path at deployment build time.
