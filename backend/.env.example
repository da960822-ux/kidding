# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Shared demo owner authentication
OWNER_PIN=change-me
OWNER_SESSION_SECRET=replace-with-a-long-random-secret
OWNER_SESSION_TTL_SECONDS=7200

# Exact FE origins, comma separated. Never use * with credentials.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-only OpenAI adapters. Never expose these values to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TIMEOUT_SECONDS=55

# Demo mode accepts only checked-in synthetic audio fixtures.
DEMO_FALLBACK=0
STT_PROVIDER=
STRUCTURE_PROVIDER=
TRANSLATION_PROVIDER=
TTS_PROVIDER=
